PORT=5001
MONGO_URI=your_mongodb_connection_string
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
JWT_SECRET_KEY=your_jwt_secret
NODE_ENV=development

# Email Verification
# Option 1: Google Apps Script Webhook (Recommended for cloud hosting: sends to ANY email without custom domain)
GMAIL_WEBHOOK_URL=your_google_apps_script_web_app_url

# Option 2: Resend API (Requires custom verified domain to send to external recipients)
RESEND_API_KEY=your_resend_api_key

# Option 3: Gmail SMTP fallback (for local development)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password
